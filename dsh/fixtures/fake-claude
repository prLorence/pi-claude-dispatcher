#!/usr/bin/env node
/** Fake `claude` for audit tests; records argv and prints a JSON envelope. */
import * as fs from "node:fs";

const args = process.argv.slice(2);
if (process.env.FAKE_CLAUDE_LOG) fs.appendFileSync(process.env.FAKE_CLAUDE_LOG, `${JSON.stringify(args)}\n`);
if (process.env.FAKE_CLAUDE_MODE === "error") {
	console.log(JSON.stringify({ is_error: true, result: "no audit", stop_reason: "error", num_turns: 1 }));
	process.exit(0);
}
if (process.env.FAKE_CLAUDE_MODE === "timeout") {
	await new Promise((r) => setTimeout(r, 5000));
}
console.log(
	JSON.stringify({
		is_error: false,
		result: "VERDICT: pass\n\n## Findings\n- [minor] note only",
		stop_reason: "end_turn",
		num_turns: 3,
		duration_ms: 1234,
		total_cost_usd: 0.05,
		usage: { input_tokens: 10, output_tokens: 5 },
	}),
);
process.exit(0);
