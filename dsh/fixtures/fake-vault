#!/usr/bin/env node
/**
 * Fake vault.mjs for tests. It records every call (argv and stdin) to
 * FAKE_VAULT_LOG and answers by FAKE_VAULT_MODE:
 *   success (default), none, fail, timeout, exit6, reject.
 * FAKE_VAULT_FAIL names the step that exits 1 (for example "repo check").
 */
import * as fs from "node:fs";

const argv = process.argv.slice(2);
const mode = process.env.FAKE_VAULT_MODE ?? "success";
const log = process.env.FAKE_VAULT_LOG;

function readStdin() {
	return new Promise((resolve) => {
		let text = "";
		process.stdin.setEncoding("utf8");
		process.stdin.on("data", (d) => (text += d));
		process.stdin.on("end", () => resolve(text));
	});
}

const stdin = await readStdin();
if (log) {
	fs.appendFileSync(log, `${JSON.stringify({ argv, stdin, cwd: process.cwd() })}\n`);
}

if (mode === "timeout") {
	await new Promise((r) => setTimeout(r, 5000));
	process.exit(0);
}

const step = argv.slice(0, 2).join(" ");
if (mode === "reject" || !["resolve", "boot", "repo", "sync", "note", "work", "log", "restore", "config", "search", "lint", "stats", "eval", "index", "init", "setup", "doctor"].includes(argv[0])) {
	process.stderr.write("bad command\n");
	process.exit(64);
}
if (mode === "none" && step === "repo check") {
	process.stdout.write("mode none\n");
	process.exit(3);
}
if (mode === "fail" && step === process.env.FAKE_VAULT_FAIL) {
	process.stderr.write("step failed on purpose\n");
	process.exit(1);
}
if (mode === "exit6" && step === "work add") {
	process.stdout.write("unmirrored traces/x.md: secret pattern\n");
	process.exit(6);
}

if (argv[0] === "resolve") {
	if (argv.includes("--json")) {
		process.stdout.write(`${JSON.stringify({ path: process.env.FAKE_VAULT_PATH ?? "/tmp/fake-vault", host: "test-host", remote: null })}\n`);
	} else {
		process.stdout.write(`path: ${process.env.FAKE_VAULT_PATH ?? "/tmp/fake-vault"}\nhost: test-host\n`);
	}
	process.exit(0);
}
if (step === "repo check") process.stdout.write("mode full\n");
else if (step === "sync pull") process.stdout.write("pulled\n");
else if (step === "sync push") process.stdout.write("pushed\n");
else if (argv[0] === "boot") process.stdout.write("BOOT TEXT\n");
else if (argv[0] === "note") process.stdout.write("note ok\n");
else if (step === "work add") process.stdout.write("work add ok\n");
else if (step === "work pending") process.stdout.write("no pending traces\n");
else if (step === "log append") process.stdout.write("logged\n");
else if (argv[0] === "restore") process.stdout.write("restored\n");
else if (argv[0] === "config") process.stdout.write("config ok\n");
else if (argv[0] === "search") process.stdout.write("[]\n");
else process.stdout.write("ok\n");
process.exit(0);
