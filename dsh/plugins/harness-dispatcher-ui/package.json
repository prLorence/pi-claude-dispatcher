{
  "name": "@pi-harness/dsh-plugin-harness-dispatcher-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "The Dispatcher sidebar panel: omp model selection, plugin settings, and the Dispatcher monitor",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
